rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spud the Piper - Firestore Security Rules

    // Public read for website content (services, tunes, reviews, social posts, CMS blocks, SEO)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /cms_blocks/{blockId} {
      allow read: if true;
      allow write: if true;
    }

    match /bagpipe_tunes/{tuneId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    match /social_posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /forum_categories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    match /seo_pages/{pageId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
