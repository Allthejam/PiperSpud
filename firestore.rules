rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stagecoach RRA Security Rules
    match /routes/{routeId} {
      allow read: if true; // Public read for driver flashcards or authenticated assessors
      allow write: if request.auth != null; // Authenticated assessors & ops managers
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
